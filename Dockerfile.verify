# One-shot verification image: Python tests + frontend build check + HTTP smoke.
FROM node:22-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /verify

# Backend dependencies (isolated venv; Debian marks system PEP 668 managed).
COPY backend/requirements.txt backend/requirements-dev.txt /verify/backend/
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r /verify/backend/requirements-dev.txt

COPY backend /verify/backend

# Frontend dependencies are installed at build time; the build check itself is
# re-executed by run.sh so its result is reported in the container exit code.
COPY frontend/package*.json /verify/frontend/
RUN cd /verify/frontend && npm install --no-audit --no-fund
COPY frontend /verify/frontend

COPY scripts/verify.sh /verify/run.sh
RUN chmod +x /verify/run.sh

CMD ["/verify/run.sh"]
